FROM python:3.12.10-slim
ARG AGENT_NAME
ENV AGENT_NAME=$AGENT_NAME PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/worker
COPY requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir -r /tmp/requirements.lock && useradd -r -u 10001 worker
COPY apps/api/governed_audience /opt/worker/governed_audience
COPY agents/worker.py /opt/worker/worker.py
USER 10001
CMD ["uvicorn","worker:app","--host","0.0.0.0","--port","8080"]
